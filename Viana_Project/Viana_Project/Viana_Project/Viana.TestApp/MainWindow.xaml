<Window x:Class="Viana.TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Viana Infrastructure Dashboard" 
        Height="900" Width="1400"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1a2332"
        Foreground="#f1f5f9"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#0d1b2a" BorderBrush="#2d5a7b" BorderThickness="0,0,0,2" Padding="32,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ Viana Infrastructure Dashboard" 
                               FontSize="28" FontWeight="Bold" 
                               Foreground="#e0f2fe" Margin="0,0,0,6"/>
                    <TextBlock Text="Manage downloads, manifests, and atomic system operations" 
                               FontSize="13" Foreground="#94a3b8"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Margin="24,0,0,0">
                    <Border Background="#1e40af" CornerRadius="8" Padding="14,10" Margin="0,0,12,0" BorderBrush="#3b82f6" BorderThickness="1">
                        <TextBlock Text="v1.0.0" Foreground="#93c5fd" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#10b981" CornerRadius="8" Padding="14,10" BorderBrush="#34d399" BorderThickness="1">
                        <TextBlock Text="● Online" Foreground="#d1fae5" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,24,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Bar Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Card 1 - Ready -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✓" FontSize="24" Foreground="#10b981" Margin="0,2,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="System Status" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="Ready" FontSize="22" FontWeight="Bold" Foreground="#10b981" Margin="0,6,0,0"/>
                                <TextBlock Text="All systems operational" Style="{StaticResource MutedText}" Margin="0,4,0,0" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status Card 2 - Active Downloads -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,7,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⬇" FontSize="24" Foreground="#3b82f6" Margin="0,2,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Active Downloads" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="txtActiveDownloads" Text="0" FontSize="22" FontWeight="Bold" Foreground="#3b82f6" Margin="0,6,0,0"/>
                                <TextBlock Text="Currently running" Style="{StaticResource MutedText}" Margin="0,4,0,0" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status Card 3 - Last Update -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="14,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🕐" FontSize="24" Foreground="#f59e0b" Margin="0,2,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Last Update" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="txtLastUpdate" Text="Never" FontSize="22" FontWeight="Bold" Foreground="#fbbf24" Margin="0,6,0,0"/>
                                <TextBlock Text="Check manifest" Style="{StaticResource MutedText}" Margin="0,4,0,0" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Tabs Section -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#e0f2fe" Margin="0,8,0,0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Grid>
                                            <Border Name="Border" 
                                                    Background="#1e293b" 
                                                    BorderBrush="#2d5a7b" 
                                                    BorderThickness="1"
                                                    CornerRadius="10,10,0,0"
                                                    Padding="22,14"
                                                    Margin="0,0,6,0"
                                                    Effect="{StaticResource None}">
                                                <ContentPresenter Name="ContentSite" 
                                                                  ContentSource="Header" 
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3b82f6"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#60a5fa"/>
                                                <Setter TargetName="Border" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.4" Color="#3b82f6"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1e40af"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#3b82f6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#e0f2fe"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: Resumable Downloader -->
                    <TabItem Header="📥 Resumable Downloader" Padding="16,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,20,20,24">
                                <!-- Download Configuration -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Download Configuration" Style="{StaticResource Title3}"/>
                                        
                                        <TextBlock Text="Download URL" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <TextBox x:Name="txtDownloadUrl" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="https://speed.hetzner.de/10MB.bin"
                                                 Margin="0,0,0,18" Height="38"/>
                                        
                                        <TextBlock Text="Save Location" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtSavePath" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Grid.Column="0"
                                                     Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="Browse..." 
                                                    Click="BrowseSavePath_Click"
                                                    Style="{StaticResource ModernButton}"
                                                    Padding="16,12"/>
                                        </Grid>

                                        <CheckBox x:Name="chkValidateHash" 
                                                  Content="✓ Validate SHA256 Hash" 
                                                  Style="{StaticResource ModernCheckBox}"
                                                  Margin="0,0,0,14" IsChecked="False"/>
                                        <TextBox x:Name="txtExpectedHash" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="Expected hash value..."
                                                 IsEnabled="{Binding ElementName=chkValidateHash, Path=IsChecked}"
                                                 Margin="0,0,0,0"
                                                 Foreground="#cbd5e1"/>
                                    </StackPanel>
                                </Border>

                                <!-- Download Controls -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Download Controls" Style="{StaticResource Title3}"/>
                                        
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button x:Name="btnStartDownload" Content="▶ Start Download" 
                                                    Click="StartDownload_Click"
                                                    Style="{StaticResource ModernButton}" 
                                                    Margin="0,0,12,0" MinWidth="160" Padding="20,14"/>
                                            <Button x:Name="btnCancelDownload" Content="⊠ Cancel" 
                                                    Click="CancelDownload_Click"
                                                    Style="{StaticResource SecondaryButton}" 
                                                    MinWidth="120" IsEnabled="False" Padding="20,14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Progress Display -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Download Progress" Style="{StaticResource Title3}"/>
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" x:Name="txtStatus" 
                                                       Text="Ready" FontWeight="SemiBold" 
                                                       Foreground="#3b82f6" Margin="0,0,16,0"/>
                                            <TextBlock Grid.Column="2" x:Name="txtProgressPercent" 
                                                       Text="0%" FontWeight="SemiBold" Foreground="#3b82f6"/>
                                        </Grid>

                                        <ProgressBar x:Name="progressBar" Height="28" 
                                                     Minimum="0" Maximum="100" Value="0"
                                                     Background="#2d5a7b"
                                                     Foreground="#3b82f6"
                                                     Style="{StaticResource ModernProgressBar}"
                                                     Margin="0,0,0,18"/>
                                        
                                        <Border Background="#0d1b2a" BorderBrush="#2d5a7b" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                            <TextBlock x:Name="txtProgressStatus" Text="Idle" Foreground="#60a5fa" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Downloaded" Style="{StaticResource SmallText}"/>
                                                <TextBlock x:Name="txtDownloaded" Text="0 MB" FontSize="15" FontWeight="SemiBold" Foreground="#3b82f6"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Total Size" Style="{StaticResource SmallText}"/>
                                                <TextBlock x:Name="txtTotalSize" Text="0 MB" FontSize="15" FontWeight="SemiBold" Foreground="#3b82f6"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Speed" Style="{StaticResource SmallText}"/>
                                                <TextBlock x:Name="txtSpeed" Text="0 MB/s" FontSize="15" FontWeight="SemiBold" Foreground="#3b82f6"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Log Viewer -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Activity Log" Style="{StaticResource Title3}" Margin="0"/>
                                            <Button Content="Clear" Click="ClearLog_Click"
                                                    HorizontalAlignment="Right" 
                                                    Style="{StaticResource TextButton}"/>
                                        </Grid>
                                        
                                        <Border Background="#0f3460" BorderBrush="#4b5563" 
                                                BorderThickness="1" CornerRadius="8">
                                            <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="txtLog" 
                                                           Padding="12" 
                                                           FontFamily="Consolas" 
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="#cbd5e1"
                                                           Text="Ready to start download..."/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Manifest Manager -->
                    <TabItem Header="📋 Manifest Manager" Padding="16,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,20,20,24">
                                <!-- Configuration -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Manifest Configuration" Style="{StaticResource Title3}"/>
                                        
                                        <TextBlock Text="Manifest URL" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <TextBox x:Name="txtManifestUrl" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="http://localhost:5000/manifest.json"
                                                 Margin="0,0,0,18" Height="38"/>
                                        
                                        <TextBlock Text="Local Active Path" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtActivePath" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Grid.Column="0"
                                                     Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="Browse..." 
                                                    Click="BrowseActivePath_Click"
                                                    Style="{StaticResource ModernButton}"/>
                                        </Grid>

                                        <Button Content="🔄 Check for Updates" 
                                                Click="CheckUpdates_Click"
                                                Style="{StaticResource ModernButton}" 
                                                MinWidth="200" HorizontalAlignment="Left" Padding="20,14"/>
                                    </StackPanel>
                                </Border>

                                <!-- Results -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Update Results" Style="{StaticResource Title3}" Margin="0,0,0,16"/>
                                        <DataGrid x:Name="gridUpdates" 
                                                  Height="250" 
                                                  AutoGenerateColumns="True" 
                                                  IsReadOnly="True"
                                                  Background="#0f3460"
                                                  Foreground="#f1f5f9"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: Rollback Manager -->
                    <TabItem Header="🔄 Rollback Manager" Padding="16,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,20,20,24">
                                <!-- Configuration -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Rollback Configuration" Style="{StaticResource Title3}"/>
                                        
                                        <TextBlock Text="Staging Path (Source)" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtStagingPath" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Grid.Column="0"
                                                     Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="Browse..." 
                                                    Click="BrowseStagingPath_Click"
                                                    Style="{StaticResource ModernButton}"/>
                                        </Grid>

                                        <TextBlock Text="Active Path (Target)" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtRollbackActivePath" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Grid.Column="0"
                                                     Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="Browse..." 
                                                    Click="BrowseRollbackActivePath_Click"
                                                    Style="{StaticResource ModernButton}"/>
                                        </Grid>

                                        <TextBlock Text="Service Name (Optional)" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <TextBox x:Name="txtServiceName" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="VianaApp"
                                                 Margin="0,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Actions -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Atomic Operations" Style="{StaticResource Title3}" Margin="0,0,0,16"/>
                                        
                                        <WrapPanel>
                                        <Button Content="💾 Create Backup" 
                                                Click="CreateBackup_Click"
                                                Style="{StaticResource ModernButton}" 
                                                MinWidth="160" Margin="0,0,12,12" Padding="18,12"/>
                                            
                                            <Button Content="⚡ Atomic Swap" 
                                                Click="PerformSwap_Click"
                                                Style="{StaticResource SecondaryButton}" 
                                                MinWidth="160" Margin="0,0,12,12" Padding="18,12"/>

                                            <Button x:Name="btnRestore" Content="↩ Restore Backup" 
                                                    Click="RestoreBackup_Click"
                                                    Style="{StaticResource ModernButton}" 
                                                    MinWidth="160" Margin="0,0,12,12" Padding="18,12"
                                                    Background="#8b5cf6"/>
                                        </WrapPanel>

                                        <TextBlock Text="Atomic operations handle file swaps safely with automatic service restart." 
                                                   Style="{StaticResource MutedText}" 
                                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
