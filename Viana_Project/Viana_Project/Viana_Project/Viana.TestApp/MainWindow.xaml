<Window x:Class="Viana.TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Viana Infrastructure Test Application" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FF5722"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E64A19"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Viana Infrastructure Test Application" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="#212121" Margin="0,0,0,5"/>
                <TextBlock Text="Test and verify ResumableDownloader, ManifestManager, and other infrastructure components" 
                           FontSize="13" Foreground="#757575"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="0,15,0,0" BorderThickness="0" Background="Transparent">
            
            <!-- Tab 1: Resumable Downloader -->
            <TabItem Header="Resumable Downloader" FontSize="14" Padding="15,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Download Configuration -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Download Configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Download URL:" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtDownloadUrl" 
                                         Text="https://speed.hetzner.de/10MB.bin"
                                         Padding="10" FontSize="13" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Save Location:" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtSavePath" 
                                             Grid.Column="0"
                                             Padding="10" FontSize="13" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="Browse..." 
                                            Click="BrowseSavePath_Click"
                                            Style="{StaticResource ModernButton}"/>
                                </Grid>

                                <CheckBox x:Name="chkValidateHash" Content="Validate Hash (SHA256)" 
                                          Margin="0,0,0,10" FontSize="13"/>
                                <TextBox x:Name="txtExpectedHash" 
                                         Padding="10" FontSize="13" 
                                         IsEnabled="{Binding ElementName=chkValidateHash, Path=IsChecked}"/>
                            </StackPanel>
                        </Border>

                        <!-- Download Controls -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Download Controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="btnStartDownload" Content="Start Download" 
                                            Click="StartDownload_Click"
                                            Style="{StaticResource ModernButton}" 
                                            Margin="0,0,10,0" Width="150"/>
                                    <Button x:Name="btnCancelDownload" Content="Cancel" 
                                            Click="CancelDownload_Click"
                                            Style="{StaticResource SecondaryButton}" 
                                            Width="150" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Progress Display -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Download Progress" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" x:Name="txtStatus" 
                                               Text="Ready" FontWeight="SemiBold" 
                                               Foreground="#2196F3" Margin="0,0,15,0"/>
                                    <TextBlock Grid.Column="2" x:Name="txtProgressPercent" 
                                               Text="0%" FontWeight="SemiBold"/>
                                </Grid>

                                <ProgressBar x:Name="progressBar" Height="30" 
                                             Minimum="0" Maximum="100" Value="0"
                                             Margin="0,0,0,15"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Downloaded:" FontSize="11" Foreground="#757575"/>
                                        <TextBlock x:Name="txtDownloaded" Text="0 MB" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Total Size:" FontSize="11" Foreground="#757575"/>
                                        <TextBlock x:Name="txtTotalSize" Text="0 MB" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Speed:" FontSize="11" Foreground="#757575"/>
                                        <TextBlock x:Name="txtSpeed" Text="0 MB/s" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Log Viewer -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Activity Log" FontSize="16" FontWeight="SemiBold"/>
                                    <Button Content="Clear Log" Click="ClearLog_Click"
                                            HorizontalAlignment="Right" 
                                            Background="Transparent" 
                                            Foreground="#2196F3"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            FontSize="12"/>
                                </Grid>
                                
                                <Border Background="#FAFAFA" BorderBrush="#E0E0E0" 
                                        BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="txtLog" 
                                                   Padding="10" 
                                                   FontFamily="Consolas" 
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Text="Ready to start download..."/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Manifest Manager (Placeholder for future) -->
            <TabItem Header="Manifest Manager" FontSize="14" Padding="15,8">
                <Border Style="{StaticResource Card}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🚧 Coming Soon" FontSize="48" 
                                   Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Manifest Manager will be implemented next" 
                                   FontSize="14" Foreground="#757575" 
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Tab 3: Rollback Manager (Placeholder for future) -->
            <TabItem Header="Rollback Manager" FontSize="14" Padding="15,8">
                <Border Style="{StaticResource Card}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🚧 Coming Soon" FontSize="48" 
                                   Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rollback Manager will be implemented later" 
                                   FontSize="14" Foreground="#757575" 
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
