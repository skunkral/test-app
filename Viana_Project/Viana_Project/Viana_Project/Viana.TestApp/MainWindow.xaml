<Window x:Class="Viana.TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Viana Infrastructure Dashboard" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1f2937"
        Foreground="#f1f5f9"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#0f3460" BorderBrush="#4b5563" BorderThickness="0,0,0,1" Padding="32,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Viana Infrastructure Dashboard" 
                               FontSize="26" FontWeight="Bold" 
                               Foreground="#f1f5f9" Margin="0,0,0,4"/>
                    <TextBlock Text="Manage downloads, manifests, and system rollbacks" 
                               FontSize="13" Foreground="#cbd5e1"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#1e3a8a" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                        <TextBlock Text="v1.0.0" Foreground="#60a5fa" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Bar Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Card 1 -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Status" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="Ready" FontSize="20" FontWeight="Bold" Foreground="#10b981" Margin="0,8,0,0"/>
                            <TextBlock Text="System operational" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Card 2 -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Active Downloads" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="txtActiveDownloads" Text="0" FontSize="20" FontWeight="Bold" Foreground="#3b82f6" Margin="0,8,0,0"/>
                            <TextBlock Text="In progress" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Card 3 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="16,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Last Update" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="txtLastUpdate" Text="Never" FontSize="20" FontWeight="Bold" Foreground="#f59e0b" Margin="0,8,0,0"/>
                            <TextBlock Text="Check manifest" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tabs Section -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#f1f5f9">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Grid>
                                            <Border Name="Border" 
                                                    Background="{StaticResource DarkGrayBrush}" 
                                                    BorderBrush="{StaticResource BorderBrush}" 
                                                    BorderThickness="0"
                                                    CornerRadius="10,10,0,0"
                                                    Padding="20,12"
                                                    Margin="0,0,8,0">
                                                <ContentPresenter Name="ContentSite" 
                                                                  ContentSource="Header" 
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1e3a8a"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: Resumable Downloader -->
                    <TabItem Header="📥 Resumable Downloader" Padding="15,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,20,20,0">
                            <StackPanel>
                                <!-- Download Configuration -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Download Configuration" Style="{StaticResource Title3}"/>
                                        
                                        <TextBlock Text="Download URL" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <TextBox x:Name="txtDownloadUrl" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="https://speed.hetzner.de/10MB.bin"
                                                 Margin="0,0,0,20"/>
                                        
                                        <TextBlock Text="Save Location" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtSavePath" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Grid.Column="0"
                                                     Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="Browse..." 
                                                    Click="BrowseSavePath_Click"
                                                    Style="{StaticResource ModernButton}"/>
                                        </Grid>

                                        <CheckBox x:Name="chkValidateHash" 
                                                  Content="Validate SHA256 Hash" 
                                                  Style="{StaticResource ModernCheckBox}"
                                                  Margin="0,0,0,12" IsChecked="False"/>
                                        <TextBox x:Name="txtExpectedHash" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="Expected hash value..."
                                                 IsEnabled="{Binding ElementName=chkValidateHash, Path=IsChecked}"
                                                 Margin="0,0,0,0"
                                                 Foreground="#cbd5e1"/>
                                    </StackPanel>
                                </Border>

                                <!-- Download Controls -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Download Controls" Style="{StaticResource Title3}"/>
                                        
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button x:Name="btnStartDownload" Content="▶ Start Download" 
                                                    Click="StartDownload_Click"
                                                    Style="{StaticResource ModernButton}" 
                                                    Margin="0,0,12,0" Width="160"/>
                                            <Button x:Name="btnCancelDownload" Content="⊠ Cancel" 
                                                    Click="CancelDownload_Click"
                                                    Style="{StaticResource SecondaryButton}" 
                                                    Width="120" IsEnabled="False"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Progress Display -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Download Progress" Style="{StaticResource Title3}"/>
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" x:Name="txtStatus" 
                                                       Text="Ready" FontWeight="SemiBold" 
                                                       Foreground="#3b82f6" Margin="0,0,16,0"/>
                                            <TextBlock Grid.Column="2" x:Name="txtProgressPercent" 
                                                       Text="0%" FontWeight="SemiBold" Foreground="#3b82f6"/>
                                        </Grid>

                                        <ProgressBar x:Name="progressBar" Height="24" 
                                                     Minimum="0" Maximum="100" Value="0"
                                                     Background="#374151"
                                                     Foreground="#3b82f6"
                                                     Style="{StaticResource ModernProgressBar}"
                                                     Margin="0,0,0,16"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Downloaded" Style="{StaticResource SmallText}"/>
                                                <TextBlock x:Name="txtDownloaded" Text="0 MB" FontSize="15" FontWeight="SemiBold" Foreground="#3b82f6"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Total Size" Style="{StaticResource SmallText}"/>
                                                <TextBlock x:Name="txtTotalSize" Text="0 MB" FontSize="15" FontWeight="SemiBold" Foreground="#3b82f6"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Speed" Style="{StaticResource SmallText}"/>
                                                <TextBlock x:Name="txtSpeed" Text="0 MB/s" FontSize="15" FontWeight="SemiBold" Foreground="#3b82f6"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Log Viewer -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Activity Log" Style="{StaticResource Title3}" Margin="0"/>
                                            <Button Content="Clear" Click="ClearLog_Click"
                                                    HorizontalAlignment="Right" 
                                                    Style="{StaticResource TextButton}"/>
                                        </Grid>
                                        
                                        <Border Background="#0f3460" BorderBrush="#4b5563" 
                                                BorderThickness="1" CornerRadius="8">
                                            <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="txtLog" 
                                                           Padding="12" 
                                                           FontFamily="Consolas" 
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="#cbd5e1"
                                                           Text="Ready to start download..."/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Manifest Manager -->
                    <TabItem Header="📋 Manifest Manager" Padding="15,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,20,20,0">
                            <StackPanel>
                                <!-- Configuration -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Manifest Configuration" Style="{StaticResource Title3}"/>
                                        
                                        <TextBlock Text="Manifest URL" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <TextBox x:Name="txtManifestUrl" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="http://localhost:5000/manifest.json"
                                                 Margin="0,0,0,20"/>
                                        
                                        <TextBlock Text="Local Active Path" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtActivePath" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Grid.Column="0"
                                                     Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="Browse..." 
                                                    Click="BrowseActivePath_Click"
                                                    Style="{StaticResource ModernButton}"/>
                                        </Grid>

                                        <Button Content="🔄 Check for Updates" 
                                                Click="CheckUpdates_Click"
                                                Style="{StaticResource ModernButton}" 
                                                Width="200" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <!-- Results -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Update Results" Style="{StaticResource Title3}" Margin="0,0,0,16"/>
                                        <DataGrid x:Name="gridUpdates" 
                                                  Height="250" 
                                                  AutoGenerateColumns="True" 
                                                  IsReadOnly="True"
                                                  Background="#0f3460"
                                                  Foreground="#f1f5f9"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: Rollback Manager -->
                    <TabItem Header="🔄 Rollback Manager" Padding="15,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,20,20,0">
                            <StackPanel>
                                <!-- Configuration -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Rollback Configuration" Style="{StaticResource Title3}"/>
                                        
                                        <TextBlock Text="Staging Path (Source)" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtStagingPath" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Grid.Column="0"
                                                     Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="Browse..." 
                                                    Click="BrowseStagingPath_Click"
                                                    Style="{StaticResource ModernButton}"/>
                                        </Grid>

                                        <TextBlock Text="Active Path (Target)" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtRollbackActivePath" 
                                                     Style="{StaticResource ModernTextBox}"
                                                     Grid.Column="0"
                                                     Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="Browse..." 
                                                    Click="BrowseRollbackActivePath_Click"
                                                    Style="{StaticResource ModernButton}"/>
                                        </Grid>

                                        <TextBlock Text="Service Name (Optional)" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                        <TextBox x:Name="txtServiceName" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="VianaApp"
                                                 Margin="0,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Actions -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Atomic Operations" Style="{StaticResource Title3}" Margin="0,0,0,16"/>
                                        
                                        <WrapPanel>
                                            <Button Content="💾 Create Backup" 
                                                    Click="CreateBackup_Click"
                                                    Style="{StaticResource ModernButton}" 
                                                    Width="160" Margin="0,0,12,12"/>
                                            
                                            <Button Content="⚡ Atomic Swap" 
                                                    Click="PerformSwap_Click"
                                                    Style="{StaticResource SecondaryButton}" 
                                                    Width="160" Margin="0,0,12,12"/>

                                            <Button x:Name="btnRestore" Content="↩ Restore Backup" 
                                                    Click="RestoreBackup_Click"
                                                    Style="{StaticResource ModernButton}" 
                                                    Width="160" Margin="0,0,12,12"
                                                    Background="#8b5cf6"/>
                                        </WrapPanel>

                                        <TextBlock Text="Atomic operations handle file swaps safely with automatic service restart." 
                                                   Style="{StaticResource MutedText}" 
                                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
